--- /dev/null
+++ b/drivers/net/phy/cvitek.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Driver for the internal cv18xx RMII PHY.
+ *
+ * The vendor PHY driver reads optional efuse tuning values, but it also
+ * falls back to hard-coded defaults that are sufficient for basic bring-up.
+ * Keep those defaults here so the driver stays self-contained in the
+ * upstream-based package tree.
+ */
+
+#include <linux/delay.h>
+#include <linux/ethtool.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/mii.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy.h>
+#include <linux/random.h>
+
+#define REG_EPHY_TOP_WRAP	0x03009800
+#define REG_EPHY_BASE		0x03009000
+
+static u32 cvitek_link_status;
+static u32 cvitek_retry_time;
+
+static int cvitek_phy_read_status(struct phy_device *phydev)
+{
+	u32 lp_val, lp_val_cap, cap_val, cap_val_temp, random_cap;
+	u32 get_random;
+	unsigned int i;
+	int ret;
+
+	ret = genphy_read_status(phydev);
+	if (ret < 0)
+		return ret;
+
+	if (cvitek_retry_time > 0)
+		cvitek_retry_time--;
+
+	if (!phydev->link) {
+		if (!cvitek_retry_time)
+			cvitek_link_status = 0;
+		return 0;
+	}
+
+	if (phydev->speed != SPEED_100 || cvitek_link_status)
+		return 0;
+
+	cvitek_link_status = 1;
+	lp_val = phy_read(phydev, MII_LPA);
+	if (phydev->autoneg != AUTONEG_ENABLE || lp_val != 0x4d61)
+		return 0;
+
+	cap_val = phy_read(phydev, MII_ADVERTISE);
+	get_random_bytes(&get_random, sizeof(get_random));
+	random_cap = (get_random & 0xde0) | 0x20;
+	if (random_cap == 0xd60)
+		random_cap = 0xde0;
+
+	cap_val_temp = (cap_val & ~0xde0) | random_cap;
+	phy_write(phydev, MII_ADVERTISE, cap_val_temp);
+
+	for (i = 0; i < 150; i++) {
+		if (!(phy_read(phydev, MII_BMSR) & BMSR_ANEGCOMPLETE))
+			break;
+		mdelay(10);
+	}
+
+	phy_modify(phydev, MII_BMCR, BMCR_ISOLATE,
+		   BMCR_ANENABLE | BMCR_ANRESTART);
+
+	for (i = 0; i < 1000; i++) {
+		if (phy_read(phydev, MII_BMSR) & BMSR_ANEGCOMPLETE)
+			break;
+		mdelay(10);
+	}
+
+	lp_val = phy_read(phydev, MII_LPA);
+	lp_val_cap = lp_val & 0xde0;
+
+	if ((phy_read(phydev, MII_BMSR) & BMSR_LSTATUS) &&
+	    lp_val && lp_val_cap != random_cap) {
+		cvitek_retry_time = 10;
+		phy_write(phydev, MII_ADVERTISE, cap_val);
+		phy_modify(phydev, MII_BMCR, BMCR_ISOLATE,
+			   BMCR_ANENABLE | BMCR_ANRESTART);
+
+		for (i = 0; i < 1000; i++) {
+			if (phy_read(phydev, MII_BMSR) & BMSR_ANEGCOMPLETE)
+				break;
+			mdelay(10);
+		}
+	} else {
+		phydev->link = 0;
+		cvitek_link_status = 0;
+		phy_write(phydev, MII_ADVERTISE, cap_val);
+		phy_modify(phydev, MII_BMCR, BMCR_ISOLATE,
+			   BMCR_ANENABLE | BMCR_ANRESTART);
+	}
+
+	return 0;
+}
+
+static int cvitek_phy_config_aneg(struct phy_device *phydev)
+{
+	return genphy_config_aneg(phydev);
+}
+
+static void cvitek_phy_write_page18_filter(void __iomem *base)
+{
+	if (of_machine_is_compatible("sophgo,sg2002") ||
+	    of_machine_is_compatible("sophgo,cv1812h")) {
+		/* CV181x/SG2002 defaults from the vendor PHY driver. */
+		writel(0x0808, base + 0x48);
+		writel(0x0808, base + 0x4c);
+		writel(0x32f8, base + 0x50);
+		writel(0xf8dc, base + 0x54);
+	} else {
+		/* CV180x defaults from the vendor PHY driver. */
+		writel(0x0801, base + 0x48);
+		writel(0x1717, base + 0x4c);
+		writel(0x3afc, base + 0x50);
+		writel(0x08d3, base + 0x54);
+		writel(0x0108, base + 0x5c);
+		writel(0x00fb, base + 0x60);
+	}
+}
+
+static int cvitek_phy_config_init(struct phy_device *phydev)
+{
+	void __iomem *top_wrap;
+	void __iomem *base;
+
+	top_wrap = ioremap(REG_EPHY_TOP_WRAP, 0x8);
+	if (!top_wrap)
+		return -EBUSY;
+
+	base = ioremap(REG_EPHY_BASE, 0x80);
+	if (!base) {
+		iounmap(top_wrap);
+		return -EBUSY;
+	}
+
+	writel(0x0001, top_wrap + 0x4);
+	writel(0x0000, base + 0x7c);
+
+	writel(0x0500, base + 0x7c);
+	writel(0x5a5a, base + 0x64);
+	writel(0x0000, base + 0x54);
+	writel(0x0bb0, base + 0x58);
+
+	writel(0x0c10, base + 0x5c);
+	writel(0x0003, base + 0x68);
+	writel(0x0000, base + 0x54);
+
+	writel(0x1000, base + 0x7c);
+	writel(0x1000, base + 0x68);
+	writel(0x3020, base + 0x6c);
+	writel(0x5040, base + 0x70);
+	writel(0x7060, base + 0x74);
+	writel(0x1708, base + 0x58);
+	writel(0x3827, base + 0x5c);
+	writel(0x5748, base + 0x60);
+	writel(0x7867, base + 0x64);
+
+	writel(0x1100, base + 0x7c);
+	writel(0x9080, base + 0x40);
+	writel(0xb0a0, base + 0x44);
+	writel(0xd0c0, base + 0x48);
+	writel(0xf0e0, base + 0x4c);
+	writel(0x9788, base + 0x50);
+	writel(0xb8a7, base + 0x54);
+	writel(0xd7c8, base + 0x58);
+	writel(0xf8e7, base + 0x5c);
+
+	writel(0x0500, base + 0x7c);
+	writel(readl(base + 0x40) | 0x0001, base + 0x40);
+	writel(readl(base + 0x4c) | 0x0820, base + 0x4c);
+
+	writel(0x0a00, base + 0x7c);
+	writel(0x3e00, base + 0x40);
+	writel(0x7864, base + 0x44);
+	writel(0x6470, base + 0x48);
+	writel(0x5f62, base + 0x4c);
+	writel(0x5a5a, base + 0x50);
+	writel(0x5458, base + 0x54);
+	writel(0xb23a, base + 0x58);
+	writel(0x94a0, base + 0x5c);
+	writel(0x9092, base + 0x60);
+	writel(0x8a8e, base + 0x64);
+	writel(0x8688, base + 0x68);
+	writel(0x8484, base + 0x6c);
+	writel(0x0082, base + 0x70);
+
+	writel(0x0b00, base + 0x7c);
+	writel(0x5252, base + 0x40);
+	writel(0x5252, base + 0x44);
+	writel(0x4b52, base + 0x48);
+	writel(0x3d47, base + 0x4c);
+	writel(0xaa99, base + 0x50);
+	writel(0x989e, base + 0x54);
+	writel(0x9395, base + 0x58);
+	writel(0x9091, base + 0x5c);
+	writel(0x8e8f, base + 0x60);
+	writel(0x8d8e, base + 0x64);
+	writel(0x8c8c, base + 0x68);
+	writel(0x8b8b, base + 0x6c);
+	writel(0x008a, base + 0x70);
+
+	writel(0x0d00, base + 0x7c);
+	writel(0x1e0a, base + 0x40);
+	writel(0x3862, base + 0x44);
+	writel(0x1e62, base + 0x48);
+	writel(0x2a08, base + 0x4c);
+	writel(0x244c, base + 0x50);
+	writel(0x1a44, base + 0x54);
+	writel(0x061c, base + 0x58);
+
+	writel(0x0e00, base + 0x7c);
+	writel(0x2d30, base + 0x40);
+	writel(0x3470, base + 0x44);
+	writel(0x0648, base + 0x48);
+	writel(0x261c, base + 0x4c);
+	writel(0x3160, base + 0x50);
+	writel(0x2d5e, base + 0x54);
+
+	writel(0x0f00, base + 0x7c);
+	writel(0x2922, base + 0x40);
+	writel(0x366e, base + 0x44);
+	writel(0x0752, base + 0x48);
+	writel(0x2556, base + 0x4c);
+	writel(0x2348, base + 0x50);
+	writel(0x0c30, base + 0x54);
+
+	writel(0x1000, base + 0x7c);
+	writel(0x1e08, base + 0x40);
+	writel(0x3868, base + 0x44);
+	writel(0x1462, base + 0x48);
+	writel(0x1a0e, base + 0x4c);
+	writel(0x305e, base + 0x50);
+	writel(0x2f62, base + 0x54);
+
+	writel(0x0100, base + 0x7c);
+	writel(readl(base + 0x68) & ~0x0f00, base + 0x68);
+
+	writel(0x1300, base + 0x7c);
+	writel(0x0012, base + 0x58);
+	writel(0x6848, base + 0x5c);
+
+	writel(0x1200, base + 0x7c);
+	cvitek_phy_write_page18_filter(base);
+
+	writel(0x0000, base + 0x7c);
+	writel(0x090e, top_wrap);
+	writel(readl(base) | 0x0100, base);
+	writel(0x0000, top_wrap + 0x4);
+
+	cvitek_link_status = 0;
+	cvitek_retry_time = 0;
+
+	iounmap(base);
+	iounmap(top_wrap);
+	return 0;
+}
+
+static int cvitek_phy_suspend(struct phy_device *phydev)
+{
+	return 0;
+}
+
+static int cvitek_phy_resume(struct phy_device *phydev)
+{
+	int ret;
+
+	ret = cvitek_phy_config_init(phydev);
+	if (ret < 0)
+		return ret;
+
+	return genphy_config_aneg(phydev);
+}
+
+static struct phy_driver cvitek_phy_drvs[] = {
+	{
+		.phy_id		= 0x00435649,
+		.phy_id_mask	= 0xffffffff,
+		.name		= "CVITEK CV18xx Internal PHY",
+		.config_init	= cvitek_phy_config_init,
+		.config_aneg	= cvitek_phy_config_aneg,
+		.read_status	= cvitek_phy_read_status,
+		.aneg_done	= genphy_aneg_done,
+		.suspend	= cvitek_phy_suspend,
+		.resume		= cvitek_phy_resume,
+		.set_loopback	= genphy_loopback,
+	},
+};
+module_phy_driver(cvitek_phy_drvs);
+
+static struct mdio_device_id __maybe_unused cvitek_phy_tbl[] = {
+	{ 0x00435649, 0xffffffff },
+	{ }
+};
+MODULE_DEVICE_TABLE(mdio, cvitek_phy_tbl);
+
+MODULE_DESCRIPTION("CV18xx internal RMII PHY driver");
+MODULE_AUTHOR("OpenAI");
+MODULE_LICENSE("GPL");
