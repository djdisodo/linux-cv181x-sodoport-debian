Description: add the CVITEK internal ePHY driver used by cv18xx boards
Origin: vendor, /root/uboot/duo-buildroot-sdk-v2/linux_5.10/drivers/net/phy/cvitek.c
Forwarded: not-needed
Last-Update: 2026-06-06

--- a/drivers/net/phy/Kconfig
+++ b/drivers/net/phy/Kconfig
@@ -219,6 +219,15 @@ config CICADA_PHY
 	help
 	  Currently supports the cis8204
 
+config CVITEK_PHY
+	tristate "CVITEK internal RMII PHY"
+	help
+	  Enable support for the internal 10/100 RMII PHY found in
+	  CVITEK and Sophgo cv18xx SoCs. The generic PHY driver can
+	  attach to this PHY once the bootloader seeds the PHY ID, but
+	  this driver provides the required analog initialization and
+	  link-status quirks for reliable carrier detection.
+
