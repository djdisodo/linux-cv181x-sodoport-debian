From 18b22e6b85d698cdc2c32b511b69ffc027e50b15 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.com>
Date: Sat, 18 Apr 2026 17:13:38 +0900
Subject: [PATCH] usb: dwc2: derive PHY mode from DT before dr_mode setup

The earlier generic-PHY role patch keys off hsotg->dr_mode, but that
field is only initialized later in probe, after low-level PHY bring-up has
already happened.

As a result, boards that need host mode to be programmed into the PHY
before power-on still never receive the override during initial bring-up.

When the resolved dr_mode is not available yet, fall back to the device
property directly so the generic PHY can still be set to the requested
role during low-level hardware enable.
---
 drivers/usb/dwc2/platform.c | 34 +++++++++++++++++++++++++++-------
 1 file changed, 27 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/dwc2/platform.c b/drivers/usb/dwc2/platform.c
index 7c5291579..4d55afb87 100644
--- a/drivers/usb/dwc2/platform.c
+++ b/drivers/usb/dwc2/platform.c
@@ -91,6 +91,32 @@ static int dwc2_get_dr_mode(struct dwc2_hsotg *hsotg)
 	return 0;
 }
 
+static enum usb_dr_mode dwc2_get_phy_dr_mode(struct dwc2_hsotg *hsotg)
+{
+	enum usb_dr_mode mode = hsotg->dr_mode;
+
+	if (mode == USB_DR_MODE_UNKNOWN)
+		mode = usb_get_dr_mode(hsotg->dev);
+	if (mode == USB_DR_MODE_UNKNOWN)
+		mode = USB_DR_MODE_OTG;
+
+	return mode;
+}
+
+static int dwc2_set_phy_mode(struct dwc2_hsotg *hsotg)
+{
+	switch (dwc2_get_phy_dr_mode(hsotg)) {
+	case USB_DR_MODE_HOST:
+		return phy_set_mode(hsotg->phy, PHY_MODE_USB_HOST);
+	case USB_DR_MODE_PERIPHERAL:
+		return phy_set_mode(hsotg->phy, PHY_MODE_USB_DEVICE);
+	case USB_DR_MODE_OTG:
+		return phy_set_mode(hsotg->phy, PHY_MODE_USB_OTG);
+	default:
+		return 0;
+	}
+}
+
 static int __dwc2_lowlevel_hw_enable(struct dwc2_hsotg *hsotg)
 {
 	struct platform_device *pdev = to_platform_device(hsotg->dev);
@@ -120,13 +146,7 @@ static int __dwc2_lowlevel_hw_enable(struct dwc2_hsotg *hsotg)
 	} else {
 		ret = phy_init(hsotg->phy);
 		if (ret == 0) {
-			if (hsotg->dr_mode == USB_DR_MODE_HOST)
-				ret = phy_set_mode(hsotg->phy, PHY_MODE_USB_HOST);
-			else if (hsotg->dr_mode == USB_DR_MODE_PERIPHERAL)
-				ret = phy_set_mode(hsotg->phy, PHY_MODE_USB_DEVICE);
-			else if (hsotg->dr_mode == USB_DR_MODE_OTG)
-				ret = phy_set_mode(hsotg->phy, PHY_MODE_USB_OTG);
-
+			ret = dwc2_set_phy_mode(hsotg);
 			if (!ret)
 				ret = phy_power_on(hsotg->phy);
 			if (ret)
-- 
