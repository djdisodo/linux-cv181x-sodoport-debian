From 3c039db887215a99d7160d19fdc3e77efe689ce9 Mon Sep 17 00:00:00 2001
From: Sodo <sodo@example.com>
Date: Sat, 18 Jul 2026 21:19:21 +0900
Subject: [PATCH] riscv: dts: sophgo: enable LicheeRV Nano Ethernet

---
 arch/riscv/boot/dts/sophgo/cv180x.dtsi                | 2 +-
 arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/sophgo/cv180x.dtsi b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
index 06b0ce5a2..61793d182 100644
--- a/arch/riscv/boot/dts/sophgo/cv180x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
@@ -250,7 +250,7 @@ gmac0: ethernet@4070000 {
 			interrupts = <SOC_PERIPHERAL_IRQ(15) IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "macirq";
 			phy-handle = <&internal_ephy>;
-			phy-mode = "internal";
+			phy-mode = "rmii";
 			resets = <&rst RST_ETH0>;
 			reset-names = "stmmaceth";
 			rx-fifo-depth = <8192>;
diff --git a/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts b/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
index b1853770d..0075d4295 100644
--- a/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
@@ -88,6 +88,14 @@ &sdhci0 {
 	disable-wp;
 };
 
+&gmac0 {
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+};
+
 &uart0 {
 	pinctrl-0 = <&uart0_cfg>;
 	pinctrl-names = "default";
