+
+static const struct v4l2_frmsize_stepwise enc_frmsize[FMT_TYPES] = {
+	[VPU_FMT_TYPE_CODEC] = {
+		.min_width = W4_MIN_ENC_PIC_WIDTH,
+		.max_width = W4_MAX_ENC_PIC_WIDTH,
