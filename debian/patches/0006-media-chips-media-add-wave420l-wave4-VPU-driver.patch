+	case W4_INIT_SEQ:
+		return "W4_INIT_SEQ";
+	case W4_SET_FB:
+		return "W4_SET_FB";
+	case W4_DEC_ENC_PIC:
+		if (is_dec)
+			return "W4_DEC_PIC";
