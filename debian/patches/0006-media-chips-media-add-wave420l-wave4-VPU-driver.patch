From 42d889766a41680b8fa1eeeeb1d6276a41c64588 Mon Sep 17 00:00:00 2001
From: sodo <djdisodo@gmail.com>
Date: Fri, 10 Apr 2026 18:30:10 +0900
Subject: [PATCH 2/2] riscv: dts: sophgo: add wave420l vpu node to cv180x

---
 arch/riscv/boot/dts/sophgo/cv180x.dtsi | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/riscv/boot/dts/sophgo/cv180x.dtsi b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
index 95c27856c..e3d3f6902 100644
--- a/arch/riscv/boot/dts/sophgo/cv180x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
@@ -466,6 +466,31 @@ usb: usb@4340000 {
 			status = "disabled";
 		};
 
+		vpu: video-codec@b020000 {
+			compatible = "sophgo,cv1800b-wave420l";
+			reg = <0x0b020000 0x10000>;
+			interrupts = <SOC_PERIPHERAL_IRQ(22) IRQ_TYPE_LEVEL_HIGH>;
+			sram-size = <0x19400>;
+			sophgo,syscon = <&syscon>;
+			clocks = <&clk CLK_AXI_VIDEO_CODEC>,
+				 <&clk CLK_H265C>,
+				 <&clk CLK_APB_H265C>,
+				 <&clk CLK_VC_SRC0>,
+				 <&clk CLK_VC_SRC1>,
+				 <&clk CLK_VC_SRC2>,
+				 <&clk CLK_CFG_REG_VC>;
+			clock-names = "clk_axi_video_codec",
+				      "clk_h265c",
+				      "clk_apb_h265c",
+				      "clk_vc_src0",
+				      "clk_vc_src1",
+				      "clk_vc_src2",
+				      "clk_cfg_reg_vc";
+			resets = <&rst RST_H265C>, <&rst RST_VIPSYS>, <&rst RST_VCSYS>;
+			reset-names = "h265c", "vipsys", "vcsys";
+			status = "disabled";
+		};
+
 		rtc@5025000 {
 			compatible = "sophgo,cv1800b-rtc", "syscon";
 			reg = <0x5025000 0x2000>;
-- 
2.50.0

