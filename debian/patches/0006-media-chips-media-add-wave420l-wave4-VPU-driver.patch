+static void _wave4_print_reg_err(struct vpu_device *vpu_dev, u32 reg_fail_reason,
+				 const char *func);
+#define PRINT_REG_ERR(dev, reason)	_wave4_print_reg_err((dev), (reason), __func__)
+
+static int wave4_allow_resident_fw_fallback = 1;
