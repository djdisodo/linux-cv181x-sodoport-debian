+	[VPU_FMT_TYPE_RAW] = {
+		.min_width = W4_MIN_ENC_PIC_WIDTH,
+		.max_width = W4_MAX_ENC_PIC_WIDTH,
+		.step_width = W4_ENC_RAW_STEP_WIDTH,
+		.min_height = W4_MIN_ENC_PIC_HEIGHT,
+		.max_height = W4_MAX_ENC_PIC_HEIGHT,
+		.step_height = W4_ENC_RAW_STEP_HEIGHT,
