Description: enable onboard AIC8800 Wi-Fi SDIO host on the SG2002 LicheeRV Nano B
Origin: vendor, adapted from /tmp/LicheeRV-Nano-Build and /tmp/radxa-overlays
Forwarded: not-needed
Last-Update: 2026-04-20

--- a/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
+++ b/arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts
@@ -74,6 +74,32 @@
 			drive-strength-microamp = <10800>;
 			power-source = <3300>;
 		};
+
+		sdhci1_cfg: sdhci1-cfg {
+			sdhci1-clk-pins {
+				pinmux = <PINMUX(PIN_SD1_CLK, 0)>;
+				bias-pull-up;
+				drive-strength-microamp = <16100>;
+				power-source = <3300>;
+			};
+
+			sdhci1-cmd-pins {
+				pinmux = <PINMUX(PIN_SD1_CMD, 0)>;
+				bias-pull-up;
+				drive-strength-microamp = <10800>;
+				power-source = <3300>;
+			};
+
+			sdhci1-data-pins {
+				pinmux = <PINMUX(PIN_SD1_D0, 0)>,
+					 <PINMUX(PIN_SD1_D1, 0)>,
+					 <PINMUX(PIN_SD1_D2, 0)>,
+					 <PINMUX(PIN_SD1_D3, 0)>;
+				bias-pull-up;
+				drive-strength-microamp = <10800>;
+				power-source = <3300>;
+			};
+		};
 	};
 };
 
@@ -88,6 +114,18 @@
 	disable-wp;
 };
 
+&sdhci1 {
+	pinctrl-0 = <&sdhci1_cfg>;
+	pinctrl-names = "default";
+	status = "okay";
+	bus-width = <4>;
+	cap-sdio-irq;
+	max-frequency = <25000000>;
+	non-removable;
+	no-mmc;
+	no-sd;
+};
+
 &uart0 {
 	pinctrl-0 = <&uart0_cfg>;
 	pinctrl-names = "default";
