#!/usr/bin/make -f

export DH_VERBOSE = 1

ARCH := riscv
CROSS_COMPILE ?= riscv64-linux-gnu-
KERNEL_NAME := cv181x-sodoport
KERNEL_ABI := 7.0.0
KERNEL_RELEASE := $(KERNEL_ABI)-$(KERNEL_NAME)
IMAGE_PACKAGE := linux-image-$(KERNEL_RELEASE)
META_PACKAGE := linux-image-$(KERNEL_NAME)
HEADER_PACKAGE := linux-headers-$(KERNEL_RELEASE)
HEADER_META_PACKAGE := linux-headers-$(KERNEL_NAME)
SOURCE_PACKAGE := linux-source-$(KERNEL_NAME)
BUILD_DIR := $(CURDIR)/debian/build
IMAGE_DIR := $(CURDIR)/debian/$(IMAGE_PACKAGE)
META_DIR := $(CURDIR)/debian/$(META_PACKAGE)
HEADER_DIR := $(CURDIR)/debian/$(HEADER_PACKAGE)
HEADER_META_DIR := $(CURDIR)/debian/$(HEADER_META_PACKAGE)
SOURCE_DIR := $(CURDIR)/debian/$(SOURCE_PACKAGE)
HEADER_INSTALL_DIR := /usr/src/$(HEADER_PACKAGE)
SOURCE_INSTALL_DIR := /usr/src
SOURCE_VERSION := $(shell dpkg-parsechangelog --show-field Version | sed 's/-[^-]*$$//')
KERNEL_CONFIG := $(CURDIR)/debian/config/$(KERNEL_NAME).config
KMAKE = $(MAKE) O="$(BUILD_DIR)" ARCH="$(ARCH)" CROSS_COMPILE="$(CROSS_COMPILE)"

%:
	dh $@

override_dh_auto_configure-arch:
	test -f "$(KERNEL_CONFIG)" || { \
		echo "Missing $(KERNEL_CONFIG). Add the board kernel config before building." >&2; \
		exit 1; \
	}
	rm -rf "$(BUILD_DIR)" "$(IMAGE_DIR)" "$(META_DIR)" "$(HEADER_DIR)" "$(HEADER_META_DIR)"
	mkdir -p "$(BUILD_DIR)"
	cp "$(KERNEL_CONFIG)" "$(BUILD_DIR)/.config"
	$(KMAKE) olddefconfig

override_dh_auto_configure-indep:
	:

override_dh_auto_build-arch:
	$(KMAKE) -j$$(nproc) Image dtbs modules
	$(KMAKE) modules_prepare

override_dh_auto_build-indep:
	:

override_dh_auto_install-arch:
	krel="$$(cat "$(BUILD_DIR)/include/config/kernel.release")"; \
	test "$$krel" = "$(KERNEL_RELEASE)" || { \
		echo "Kernel release $$krel does not match expected $(KERNEL_RELEASE)." >&2; \
		exit 1; \
	}; \
	kdata="$(IMAGE_DIR)/usr/lib/$(IMAGE_PACKAGE)"; \
	hdst="$(HEADER_DIR)$(HEADER_INSTALL_DIR)"; \
	mkdir -p "$(IMAGE_DIR)/boot" "$$kdata" "$$hdst" "$(HEADER_DIR)/lib/modules/$$krel"; \
	cp "$(BUILD_DIR)/arch/riscv/boot/Image" "$(IMAGE_DIR)/boot/vmlinuz-$$krel"; \
	cp "$(BUILD_DIR)/System.map" "$(IMAGE_DIR)/boot/System.map-$$krel"; \
	cp "$(BUILD_DIR)/.config" "$(IMAGE_DIR)/boot/config-$$krel"; \
	cp "$(BUILD_DIR)/arch/riscv/boot/Image" "$$kdata/Image"; \
	cp "$(BUILD_DIR)/System.map" "$$kdata/System.map"; \
	cp "$(BUILD_DIR)/.config" "$$kdata/config"; \
	printf '%s\n' "$$krel" > "$$kdata/kernel.release"; \
	if [ -d "$(BUILD_DIR)/arch/riscv/boot/dts" ]; then \
		mkdir -p "$$kdata/dts"; \
		( cd "$(BUILD_DIR)/arch/riscv/boot/dts" && \
			find . -type f \( -name '*.dtb' -o -name '*.dtbo' \) -print0 | \
			tar --null -T - -cf - ) | \
			tar -C "$$kdata/dts" -xf -; \
	fi; \
	$(KMAKE) INSTALL_MOD_PATH="$(IMAGE_DIR)" modules_install; \
	rm -f "$(IMAGE_DIR)/lib/modules/$$krel/build"; \
	rm -f "$(IMAGE_DIR)/lib/modules/$$krel/source"; \
	for file in Makefile Kbuild Kconfig; do \
		cp "$(CURDIR)/$$file" "$$hdst/$$file"; \
	done; \
	( cd "$(CURDIR)" && tar -cf - arch/riscv include scripts ) | \
		tar -C "$$hdst" -xf -; \
	for file in .config Module.symvers System.map; do \
		if [ -f "$(BUILD_DIR)/$$file" ]; then \
			cp "$(BUILD_DIR)/$$file" "$$hdst/$$file"; \
		fi; \
	done; \
	if [ -d "$(BUILD_DIR)/include/config" ]; then \
		mkdir -p "$$hdst/include/config"; \
		cp -a "$(BUILD_DIR)/include/config/." "$$hdst/include/config/"; \
	fi; \
	if [ -d "$(BUILD_DIR)/include/generated" ]; then \
		mkdir -p "$$hdst/include/generated"; \
		cp -a "$(BUILD_DIR)/include/generated/." "$$hdst/include/generated/"; \
	fi; \
	if [ -d "$(BUILD_DIR)/arch/riscv/include/generated" ]; then \
		mkdir -p "$$hdst/arch/riscv/include/generated"; \
		cp -a "$(BUILD_DIR)/arch/riscv/include/generated/." "$$hdst/arch/riscv/include/generated/"; \
	fi; \
	ln -s "$(HEADER_INSTALL_DIR)" "$(HEADER_DIR)/lib/modules/$$krel/build"; \
	ln -s "$(HEADER_INSTALL_DIR)" "$(HEADER_DIR)/lib/modules/$$krel/source"

override_dh_auto_install-indep:
	version="$(SOURCE_VERSION)"; \
	archive="$(SOURCE_DIR)$(SOURCE_INSTALL_DIR)/$(SOURCE_PACKAGE)-$$version.tar.xz"; \
	epoch="$${SOURCE_DATE_EPOCH:-0}"; \
	mkdir -p "$(SOURCE_DIR)$(SOURCE_INSTALL_DIR)"; \
	find "$(CURDIR)" \
		\( -path "$(CURDIR)/.git" -o -path "$(CURDIR)/.pc" -o -path "$(BUILD_DIR)" -o \
		   -path "$(CURDIR)/debian/.debhelper" -o -path "$(IMAGE_DIR)" -o \
		   -path "$(META_DIR)" -o -path "$(HEADER_DIR)" -o \
		   -path "$(HEADER_META_DIR)" -o -path "$(SOURCE_DIR)" \) -prune -o \
		\( -type f -o -type l \) \
		! -name '*.substvars' \
		! -name 'files' \
		! -name 'debhelper-build-stamp' \
		-printf '%P\0' | \
	tar -C "$(CURDIR)" --null -T - \
		--sort=name \
		--mtime="@$$epoch" \
		--clamp-mtime \
		--owner=0 --group=0 --numeric-owner \
		--transform "s,^,$(SOURCE_PACKAGE)-$$version/," \
		-cJf "$$archive"

override_dh_auto_test:
	:

override_dh_auto_clean:
	rm -rf "$(BUILD_DIR)" "$(IMAGE_DIR)" "$(META_DIR)" "$(HEADER_DIR)" "$(HEADER_META_DIR)" "$(SOURCE_DIR)"
