# Flavour-specific overrides for the cv181x-sodoport kernel on Milk-V Duo 256M.
#
# Keep this fragment for:
# - board-specific enablement on top of the SoC baseline
# - package release identity
# - bring-up peripherals useful for the Duo 256M target
#
# Debian-wide common policy belongs in debian-common.fragment.

# Keep the installed kernel release stable and flavour-specific.
CONFIG_LOCALVERSION="-cv181x-sodoport"
CONFIG_LOCALVERSION_AUTO=n

# Explicitly keep clearly irrelevant generic distro requests out of this
# board build.
# CONFIG_CRYPTO_AES_TI is not set
# CONFIG_VIRTIO_PCI is not set

# Keep the common cgroup v2 controllers available for systemd and container
# workloads without enabling RT scheduling groups on this small board.
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_PSI=y
CONFIG_CGROUP_MISC=y

# Keep installed modules compressed to reduce the rootfs footprint while still
# letting initramfs-tools include the subset it needs via MODULES=most.
CONFIG_MODULE_COMPRESS=y
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y

# systemd's libbpf helpers need kernel BTF, but full module BTF is still too
# expensive for a 256 MiB target. Keep kernel BTF enabled and strip installed
# modules during packaging instead of disabling debug metadata at Kconfig time.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# Common USB Wi-Fi drivers for bring-up and field use.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_MAC80211=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m

# Common USB Ethernet adapters.
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m

# Common USB serial adapters and WWAN modems.
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_WWAN=m

# Basic USB input support.
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m

# NanoKVM PCIe status OLED on a GPIO-backed I2C bus.
CONFIG_I2C_GPIO=m
CONFIG_DRM=m
CONFIG_DRM_SSD130X=m
CONFIG_DRM_SSD130X_I2C=m

# The NanoKVM device port is permanently wired as a USB peripheral.
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_DWC2_HOST is not set
# CONFIG_USB_DWC2_DUAL_ROLE is not set

# ConfigFS functions used to compose KVM gadgets from userspace.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_UAC1=y
# CONFIG_USB_CONFIGFS_F_UAC1_LEGACY is not set
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_UVC=y
