# Board and package-specific overrides for the Milk-V Duo 256M kernel.
#
# Keep this fragment for:
# - board-specific enablement on top of the SoC baseline
# - package release identity
# - bring-up peripherals useful for the Duo 256M target
#
# Debian-wide common policy belongs in debian-common.fragment.

# Keep the installed kernel release stable and board-specific.
CONFIG_LOCALVERSION="-sg2002-milkv-duo256m"
CONFIG_LOCALVERSION_AUTO=n

# Explicitly keep clearly irrelevant generic distro requests out of this
# board build.
# CONFIG_CRYPTO_AES_TI is not set
# CONFIG_VIRTIO_PCI is not set

# Common USB Wi-Fi drivers for bring-up and field use.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_MAC80211=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m

# Common USB Ethernet adapters.
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m

# Common USB serial adapters and WWAN modems.
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_WWAN=m

# Basic USB input support.
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m
